        "spark-plugs"
      ]
    },
    {
      "action_key": "cool-engine-prepare-plug-access",
      "title": "Cool the engine and prepare access",
      "instruction": "Work on a cool engine and remove only the covers or ducting required to reach the ignition coils and spark-plug wells.",

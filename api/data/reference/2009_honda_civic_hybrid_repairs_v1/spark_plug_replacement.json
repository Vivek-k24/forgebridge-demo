    {
      "action_key": "confirm-hybrid-plug-spec",
      "title": "Confirm the Hybrid spark-plug specification",
      "instruction": "Confirm the exact 1.3L Civic Hybrid engine before beginning. This configuration uses eight spark plugs; do not apply that plug count to the 1.8L or Si engines.",

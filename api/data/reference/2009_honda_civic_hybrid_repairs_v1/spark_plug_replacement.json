    },
    {
      "action_key": "disconnect-remove-coils",
      "title": "Disconnect and remove the ignition coils",
      "instruction": "Track the coil connectors as needed, disconnect them, remove the coils, and inspect the boots for oil contamination, carbon tracking, or damage.",
      "position": 2,
      "skippable": false,
      "prerequisite_action_keys": [
        "cool-engine-prepare-plug-access"
      ],
      "requirement_use_keys": []
    },
    {
      "action_key": "clean-remove-old-plugs",
      "title": "Clean the plug wells and remove the old plugs",
      "instruction": "Remove loose debris before extracting the plugs, then remove the old plugs with the spark-plug socket and compare wear or deposits across cylinders.",
      "position": 3,
      "skippable": false,
      "prerequisite_action_keys": [
        "disconnect-remove-coils"
      ],
      "requirement_use_keys": [
        "spark-plug-socket",
        "debris-removal"
      ]
    },
    {
      "action_key": "hand-start-new-plugs",
      "title": "Hand-start the new spark plugs",
      "instruction": "Use the correct pre-gapped plugs, reference gap 1.1 mm (0.043 in.), and start each plug by hand so the cylinder-head threads are not cross-threaded.",
      "position": 4,
      "skippable": false,
      "prerequisite_action_keys": [
        "clean-remove-old-plugs"
      ],
      "requirement_use_keys": [
        "spark-plugs"
      ]
    },
    {

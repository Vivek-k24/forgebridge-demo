      "action_key": "secure-vehicle",
      "title": "Secure the vehicle",
      "instruction": "Park on the hard, level surface, apply the parking brake, chock the wheels that remain on the ground, and loosen the wheel nuts slightly before lifting.",
      "warning_text": "Never work under a vehicle supported only by a jack.",
      "position": 1,
      "skippable": false,
      "prerequisite_action_keys": [
        "confirm-wheel-tire-specification"
      ],

    {
      "action_key": "confirm-wheel-tire-specification",
      "title": "Confirm the wheel and tire specification",
      "instruction": "Confirm the installed tire and wheel match the exact 2009 Civic Hybrid configuration. The reference tire size is 195/65R15; use the vehicle placard for the final cold-pressure specification.",

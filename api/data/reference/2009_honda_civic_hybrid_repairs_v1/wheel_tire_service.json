      ]
    },
    {
      "action_key": "inspect-tire-wheel",
      "title": "Inspect the tire and wheel",
      "instruction": "Inspect tread, sidewalls, bead area, wheel condition, and visible wear patterns before reinstallation.",
      "position": 3,
      "skippable": false,
      "prerequisite_action_keys": [
        "lift-and-remove-wheel"
      ],
      "requirement_use_keys": []
    },
    {
      "action_key": "reinstall-wheel",
      "title": "Reinstall and torque the wheel",
      "instruction": "Seat the wheel squarely, hand-start every wheel nut, lower the vehicle enough to prevent wheel rotation, then tighten the nuts evenly in a crisscross pattern to 108 N·m (80 lbf·ft).",
      "position": 4,
      "skippable": false,
      "prerequisite_action_keys": [
        "inspect-tire-wheel"
      ],
      "requirement_use_keys": [

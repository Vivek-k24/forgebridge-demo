      ]
    },
    {
      "action_key": "lift-and-remove-wheel",
      "title": "Lift the vehicle and remove the wheel",
      "instruction": "Use the correct lift point, raise the vehicle, support it safely as required for the work, then remove the wheel nuts and wheel.",
      "position": 2,
      "skippable": false,
      "prerequisite_action_keys": [
        "secure-vehicle"
      ],
      "requirement_use_keys": [
        "vehicle-jack",

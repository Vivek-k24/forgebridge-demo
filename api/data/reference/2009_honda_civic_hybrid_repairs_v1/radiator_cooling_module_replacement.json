    {
      "action_key": "cool-drain-cooling-system",
      "title": "Cool and drain the cooling system",
      "instruction": "Allow the engine to cool fully, remove the required lower access panels, and drain the engine coolant into a suitable container before disconnecting cooling-system components.",
      "warning_text": "Hot coolant and a pressurized cooling system can cause severe burns.",
      "position": 0,
      "skippable": false,
      "prerequisite_action_keys": [],
      "requirement_use_keys": [
        "coolant-drain-container",
        "safe-underbody-access"
      ]
    },
    {
      "action_key": "remove-front-access-components",
      "title": "Remove front access components",
      "instruction": "Remove the front wheels and required undercover/splash shield, engine cover, resonator, intake duct, air-cleaner assembly, and front grille cover needed by the service sequence.",
      "position": 1,
      "skippable": false,
      "prerequisite_action_keys": [
        "cool-drain-cooling-system"
      ],
      "requirement_use_keys": [
        "safe-underbody-access",
        "socket-ratchet"
      ]
    },
    {
      "action_key": "disconnect-upper-support-and-wiring",
      "title": "Disconnect upper supports and fan wiring",
      "instruction": "Remove the radiator upper bracket/cushion and related clips, disconnect the hood-latch switch as required, release harness clamps, and disconnect the radiator-fan and condenser-fan motor connectors.",
      "position": 2,
      "skippable": false,
      "prerequisite_action_keys": [
        "remove-front-access-components"
      ],
      "requirement_use_keys": [
        "radiator-shroud",
        "cooling-fan",
        "condenser-fan"
      ]
    },
    {
      "action_key": "disconnect-hoses-and-cvt-cooler",
      "title": "Disconnect radiator hoses and CVT cooler connections",
      "instruction": "Disconnect the upper and lower radiator hoses and the continuously variable transmission cooler hoses as required by the Hybrid radiator procedure. Capture any fluid loss and protect open connections.",
      "position": 3,
      "skippable": false,
      "prerequisite_action_keys": [
        "disconnect-upper-support-and-wiring"
      ],
      "requirement_use_keys": [
        "upper-hose",
        "lower-hose-a",
        "lower-hose-b",
        "hose-clamp-pliers",
        "safe-underbody-access"
      ]
    },
    {
      "action_key": "remove-radiator-fan-assemblies",
      "title": "Remove the fan assemblies and radiator",
      "instruction": "Remove the cooling-fan shroud assemblies and lift the radiator out without damaging the adjacent A/C condenser or surrounding fins.",
      "position": 4,
      "skippable": false,
      "prerequisite_action_keys": [
        "disconnect-hoses-and-cvt-cooler"
      ],
      "requirement_use_keys": [
        "radiator",
        "radiator-shroud",
        "cooling-fan",
        "condenser-fan"
      ]
    },
    {
      "action_key": "install-radiator-cooling-module",
      "title": "Install the radiator and restore the cooling module",
      "instruction": "Seat the replacement radiator in its mounts, reinstall reusable or replacement fan/shroud components, reconnect the hoses, cooler connections, wiring, upper supports, and removed access components in the service-manual reverse sequence.",

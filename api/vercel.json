{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["iad1"],
  "functions": {
    "partgraph/main.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "https://vivek-k24.github.io/forgebridge-demo/"
    },
    {
      "source": "/forgebridge-demo/:path*",
      "destination": "https://vivek-k24.github.io/forgebridge-demo/:path*"
    }
  ]
}
